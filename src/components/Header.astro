---
import { Icon } from "astro-icon/components";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const current = Astro.url.pathname;
const nav = [
  { href: `${base}docs/authoring-pipelines/`, label: "Author pipelines" },
  { href: `${base}docs/tractor-vs-attractor/`, label: "Spec comparison" },
];
---

<header class="border-border/80 sticky top-0 z-50 border-b bg-[oklch(0.135_0.01_55/0.88)] backdrop-blur-xl">
  <div class="shell flex h-16 items-center justify-between gap-5">
    <a class="group inline-flex items-center gap-3" href={base} aria-label="Tractor home">
      <span class="border-primary/50 bg-primary/10 text-primary grid size-8 place-items-center rounded-md border">
        <Icon name="lucide:blocks" class="size-4" aria-hidden="true" />
      </span>
      <span class="font-mono text-sm font-bold tracking-[0.16em] uppercase">Tractor</span>
    </a>

    <nav class="hidden items-center gap-6 sm:flex" aria-label="Primary navigation">
      {
        nav.map((item) => (
          <a
            class:list={[
              "hover:text-foreground text-sm transition-colors",
              current === item.href ? "text-primary" : "text-muted-foreground",
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors"
      href="https://github.com/tylergannon/tractor"
    >
      <Icon name="lucide:github" class="size-4" aria-hidden="true" />
      <span class="hidden md:inline">GitHub</span>
    </a>
  </div>
</header>
