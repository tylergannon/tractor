---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "./Layout.astro";

interface Props {
  entry: CollectionEntry<"docs">;
  entries: CollectionEntry<"docs">[];
  headings: MarkdownHeading[];
}

const { entry, entries, headings } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
---

<Layout title={`${entry.data.title} · Tractor`} description={entry.data.description}>
  <Header />
  <div class="shell grid gap-12 pt-8 lg:grid-cols-[13rem_minmax(0,1fr)] xl:grid-cols-[13rem_minmax(0,1fr)_12rem]">
    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <p class="text-muted-foreground mb-4 font-mono text-[0.65rem] font-semibold tracking-[0.16em] uppercase">
          Documentation
        </p>
        <nav class="space-y-1" aria-label="Documentation">
          {
            entries.map((item) => (
              <a
                class:list={[
                  "block rounded-md border-l-2 px-3 py-2 text-sm transition-colors",
                  item.id === entry.id
                    ? "border-primary bg-primary/10 text-foreground"
                    : "border-transparent text-muted-foreground hover:bg-muted/60 hover:text-foreground",
                ]}
                href={`${base}docs/${item.id}/`}
              >
                {item.data.title}
              </a>
            ))
          }
        </nav>
      </div>
    </aside>

    <main class="min-w-0">
      <div class="mb-5 flex flex-wrap items-center gap-3 lg:hidden">
        {
          entries.map((item) => (
            <a
              class:list={[
                "rounded-full border px-3 py-1.5 text-xs",
                item.id === entry.id
                  ? "border-primary/50 bg-primary/10 text-primary"
                  : "border-border text-muted-foreground",
              ]}
              href={`${base}docs/${item.id}/`}
            >
              {item.data.title}
            </a>
          ))
        }
      </div>

      <header class="border-border mb-10 border-b pb-9">
        <p class="eyebrow mb-4">{entry.data.eyebrow}</p>
        <h1 class="font-serif text-4xl leading-[0.98] font-medium tracking-[-0.035em] text-balance sm:text-6xl">
          {entry.data.title}
        </h1>
        <p class="text-muted-foreground mt-5 max-w-3xl text-lg leading-8">{entry.data.description}</p>
        {
          entry.data.sourceUrl && (
            <a
              class="text-muted-foreground hover:text-primary mt-5 inline-flex items-center gap-2 font-mono text-xs transition-colors"
              href={entry.data.sourceUrl}
            >
              <Icon name="lucide:external-link" class="size-3.5" aria-hidden="true" />
              {entry.data.sourceLabel ?? "View source"}
            </a>
          )
        }
      </header>

      <article class="doc-prose max-w-[48rem]">
        <slot />
      </article>
    </main>

    <aside class="hidden xl:block">
      <div class="sticky top-24">
        <p class="text-muted-foreground mb-4 font-mono text-[0.65rem] font-semibold tracking-[0.16em] uppercase">
          On this page
        </p>
        <nav class="space-y-2 border-l pl-4" aria-label="On this page">
          {
            sectionHeadings.map((heading) => (
              <a class="text-muted-foreground hover:text-foreground block text-xs leading-5 transition-colors" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))
          }
        </nav>
      </div>
    </aside>
  </div>
  <Footer />
</Layout>
