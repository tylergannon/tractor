#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache_root=${XDG_CACHE_HOME:-"$HOME/.cache"}/tractor/codex-plugin
candidate=$cache_root/tractor.$$

mkdir -p "$cache_root"
trap 'rm -f "$candidate"' EXIT HUP INT TERM

cd "$plugin_root"
go build -o "$candidate" ./cmd/tractor
if command -v sha256sum >/dev/null 2>&1; then
	binary_hash=$(sha256sum "$candidate")
else
	binary_hash=$(shasum -a 256 "$candidate")
fi
binary_hash=${binary_hash%% *}
binary=$cache_root/tractor-$binary_hash
mv -f "$candidate" "$binary"
trap - EXIT HUP INT TERM

exec "$binary" mcp
