#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache_root=${XDG_CACHE_HOME:-"$HOME/.cache"}/tractor/codex-plugin
mkdir -p "$cache_root"
run_root=$(mktemp -d "$cache_root/run.XXXXXX")
binary=$run_root/tractor
server_pid=

cleanup() {
	rm -rf "$run_root"
}

forward_signal() {
	if [ -n "$server_pid" ]; then
		kill -TERM "$server_pid" 2>/dev/null || true
	fi
}

trap cleanup EXIT
trap forward_signal HUP INT TERM

cd "$plugin_root"
go build -o "$binary" ./cmd/tractor
"$binary" mcp <&0 &
server_pid=$!

set +e
wait "$server_pid"
status=$?
while kill -0 "$server_pid" 2>/dev/null; do
	wait "$server_pid"
	status=$?
done
set -e
exit "$status"
